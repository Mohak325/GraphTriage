# Environment Configuration Template for Person C Subsystem
# ==============================================================================
# INTEGRATION MODES
# ==============================================================================
# USE_FIXTURES: Set to true for local testing, demo, and offline verification.
# Set to false in production AWS integration (Week 11) to connect to live Person A & B services.
USE_FIXTURES=true

# MOCK_BEDROCK: Set to true for offline deterministic LLM reasoning.
# Set to false to invoke Amazon Bedrock Claude 3.5 Sonnet directly via boto3.
MOCK_BEDROCK=true

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
PROJECT_NAME="Carrier-Grade Telecom Cloud RCA & SLA Liability Service"
ENVIRONMENT=development
DEBUG=true
PORT=8000

# ==============================================================================
# AMAZON BEDROCK (CLAUDE 3.5 SONNET)
# ==============================================================================
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_TIMEOUT_SECONDS=30
BEDROCK_MAX_RETRIES=3

# ==============================================================================
# AGORA SAFETY & COMPLIANCE GUARDRAIL
# ==============================================================================
# Time window in seconds within which live Prometheus telemetry estimation must have occurred
AGORA_WINDOW_SECONDS=5.0

# ==============================================================================
# HITL CRYPTOGRAPHIC GOVERNANCE
# ==============================================================================
HITL_SECRET_KEY=carrier-grade-hitl-hmac-secret-key-change-in-production-2026
HITL_TOKEN_EXPIRY_MINUTES=60

# ==============================================================================
# LASM SLA LIABILITY THRESHOLDS
# ==============================================================================
# Trust < 0.30 -> 30% MRC penalty
LASM_HIGH_PENALTY_THRESHOLD=0.30
# 0.30 <= Trust < 0.60 -> 20% MRC penalty
LASM_MED_PENALTY_THRESHOLD=0.60
# 0.60 <= Trust < 0.80 -> 10% MRC penalty
LASM_LOW_PENALTY_THRESHOLD=0.80

# ==============================================================================
# PRODUCTION ENDPOINTS (Used only when USE_FIXTURES=false)
# ==============================================================================
PERSON_A_MCP_URL=http://mcp-telemetry.internal:8080
PERSON_B_RCA_URL=http://sagemaker-rca.internal:8000
VECTOR_DB_URL=postgresql://telecom_user:secret@localhost:5432/vectordb
