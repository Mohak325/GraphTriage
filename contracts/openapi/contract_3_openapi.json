{
  "openapi": "3.1.0",
  "info": {
    "title": "Intelligent Telecom Cloud RCA & SLA Liability Service (Contract 3)",
    "version": "2.0.0",
    "description": "Carrier-grade API served by Person C for governed agentic diagnostics, SLA liability attribution (LASM), and remediation planning."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local Development / Carrier Testbed"
    },
    {
      "url": "https://api.rca.telecom.carrier.internal",
      "description": "Production AWS API Gateway"
    }
  ],
  "paths": {
    "/api/rca/diagnose-and-remediate": {
      "post": {
        "summary": "Governed Agentic Diagnostics & SLA Liability Attribution",
        "operationId": "diagnose_and_remediate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiagnoseAndRemediateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful diagnostic and remediation synthesis with SLA attribution",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnoseAndRemediateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error"
          },
          "500": {
            "description": "Internal Agentic Synthesis Error"
          }
        }
      }
    },
    "/api/hitl/approve": {
      "post": {
        "summary": "Approve pending remediation plan with cryptographic signature",
        "operationId": "hitl_approve",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "incident_id",
                  "approval_token",
                  "operator_signature"
                ],
                "properties": {
                  "incident_id": {
                    "type": "string"
                  },
                  "approval_token": {
                    "type": "string"
                  },
                  "operator_signature": {
                    "type": "string"
                  },
                  "comments": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Remediation plan approved and dispatched to AWS Systems Manager"
          },
          "403": {
            "description": "Invalid or expired cryptographic token"
          },
          "404": {
            "description": "Incident not found"
          }
        }
      }
    },
    "/api/hitl/reject": {
      "post": {
        "summary": "Reject pending remediation plan",
        "operationId": "hitl_reject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "incident_id",
                  "approval_token",
                  "reason"
                ],
                "properties": {
                  "incident_id": {
                    "type": "string"
                  },
                  "approval_token": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Remediation rejected"
          },
          "403": {
            "description": "Invalid token"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DiagnoseAndRemediateRequest": {
        "$defs": {
          "ActiveProbingResults": {
            "additionalProperties": false,
            "properties": {
              "probes_executed": {
                "description": "Diagnostic probes executed",
                "items": {
                  "type": "string"
                },
                "title": "Probes Executed",
                "type": "array"
              },
              "isolated_cv": {
                "description": "Isolated Configuration Variable root cause",
                "title": "Isolated Cv",
                "type": "string"
              },
              "confidence": {
                "description": "Diagnostic probing confidence",
                "maximum": 1.0,
                "minimum": 0.0,
                "title": "Confidence",
                "type": "number"
              }
            },
            "required": [
              "isolated_cv",
              "confidence"
            ],
            "title": "ActiveProbingResults",
            "type": "object"
          },
          "ActorContextItem": {
            "additionalProperties": false,
            "properties": {
              "actor_id": {
                "description": "Legal/operational actor identifier e.g. MNO-Core-Operator, Cloud-Infra-Provider",
                "title": "Actor Id",
                "type": "string"
              },
              "service": {
                "description": "Service or component managed by this actor e.g. amf-01",
                "title": "Service",
                "type": "string"
              },
              "mrc_usd": {
                "description": "Monthly Recurring Charge for this service in USD",
                "minimum": 0.0,
                "title": "Mrc Usd",
                "type": "number"
              }
            },
            "required": [
              "actor_id",
              "service",
              "mrc_usd"
            ],
            "title": "ActorContextItem",
            "type": "object"
          },
          "PcapVerification": {
            "additionalProperties": false,
            "properties": {
              "protocol_violation": {
                "description": "True if signaling protocol flow was violated",
                "title": "Protocol Violation",
                "type": "boolean"
              },
              "deviating_frame": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Exact frame number where deviation occurred",
                "title": "Deviating Frame"
              },
              "procedure": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "3GPP procedure name",
                "title": "Procedure"
              },
              "cause_code": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "3GPP or HTTP/2 cause code",
                "title": "Cause Code"
              }
            },
            "required": [
              "protocol_violation"
            ],
            "title": "PcapVerification",
            "type": "object"
          },
          "RCAResponse": {
            "additionalProperties": false,
            "description": "Contract 2: POST /api/rca/analyze Response.",
