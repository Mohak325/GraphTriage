# =============================================
# GRAPHTRIAGE — Docker Environment Variables
# =============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================

# ----- Neo4j -----
NEO4J_AUTH=neo4j/graphtriage_dev
NEO4J_URI=bolt://neo4j:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ----- Redis -----
REDIS_URL=redis://redis:6379/0

# ----- Backend -----
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEBUG=true

# ----- Frontend -----
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ----- AI & LLM Providers -----
# Shared Google Gemini API Key (Free tier for all 3 PCs)
GEMINI_API_KEY=your_gemini_api_key_here

# ----- AWS Cloud Credentials (Phase 4) -----
# For Amazon Bedrock, Neptune, DynamoDB, S3, and SNS:
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# Optional: Required only if using temporary AWS Academy / Learner Lab credentials
AWS_SESSION_TOKEN=your_aws_session_token_here
AWS_REGION=us-east-1

# Amazon Bedrock Foundation Model ID
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Amazon Neptune Graph Database
GRAPH_BACKEND=neo4j
NEPTUNE_ENDPOINT=wss://localhost:8182/gremlin
NEPTUNE_USE_SSL=true

# Amazon OpenSearch
OPENSEARCH_URL=http://localhost:9200

# AWS SNS & DynamoDB
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:GraphTriage-SRE-Alerts
DYNAMODB_TABLE=GraphTriage-Remediations

# ----- Logging -----
LOG_LEVEL=INFO

